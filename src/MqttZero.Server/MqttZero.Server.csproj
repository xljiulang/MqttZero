<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MqttZero.Server</RootNamespace>
    <AssemblyName>MqttZero.Server</AssemblyName>
    <Description>High-performance MQTT 5 broker core.</Description>
    <PackageId>MqttZero.Server</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <ProjectReference Include="..\MqttZero\MqttZero.csproj" />
    <InternalsVisibleTo Include="MqttZero.Benchmarks" />
    <InternalsVisibleTo Include="MqttZero.BrokerBenchmarks" />
    <InternalsVisibleTo Include="MqttZero.AspNetCore" />
    <InternalsVisibleTo Include="MqttZero.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
